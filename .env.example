NODE_ENV=development
PORT=3000

# Storage (S3 / Local)
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bedtime-ai-audio-storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_ENDPOINT=http://localhost:4566 # for localstack
LOCAL_STORAGE_DIR=./storage_uploads

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_STORY_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# TTS & Voice Providers (sarvam | elevenlabs | mock)
TTS_PROVIDER=mock
VOICE_PROVIDER=mock
SPEECH_PROVIDER=mock

SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Audio Strategy (full_file | streaming)
AUDIO_MODE=full_file

# Limits & Expirations
SIGNED_URL_EXPIRY_SECONDS=900
MAX_VOICE_FILE_MB=25
